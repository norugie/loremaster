DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional, for development only: a test server's ID. When set, slash commands
# are synced to that server and show up at once. When empty, they are synced
# globally to every server the bot is in (Discord can take up to an hour).
DISCORD_GUILD_ID=

# Folder of the lore vault on this PC; mounted read-only into the container at /vault.
VAULT_PATH=
# Optional: set to rw only when /lore update is turned on (update.enabled in the
# config); the vault is mounted read-only otherwise.
# VAULT_MODE=ro
# Optional: where the config file is, as the container sees it (default lorebot.yaml
# in the repo folder), e.g. /vault/lorebot.yaml to keep it in the vault.
# LOREBOT_CONFIG=
# Optional: where Ollama runs (default http://host.docker.internal:11434, the Windows host).
# OLLAMA_HOST=
